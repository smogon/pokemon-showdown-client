---
import { readFile } from 'node:fs/promises';
import Layout from '../../includes/Layout.astro';
import { News } from '../../lib/news.ts';

export const prerender = false;

const post = await News.getPost(Astro.params.newsid);
if (!post) {
	// TODO: figure out the 404 page situation
	const html = await readFile(import.meta.dirname + '/../dirindex/404.html', 'utf8');
	return new Response(html, { status: 404, headers: { 'Content-Type': 'text/html; charset=utf-8' } });
}

const date = new Date(post.date * 1000);
---
<Layout title={post.title}>
	<link slot="head" rel="stylesheet" href="https://play.pokemonshowdown.com/style/battle-log.css?v0.1" />

	<article data-post-page data-edit-url={`/news/${post.id}.json`}>
		<h1>{post.title}</h1>
		<Fragment set:html={post.summaryHTML} />
		<Fragment set:html={post.detailsHTML} />
		<p>
			&mdash;<strong>{post.author}</strong> {}
			<small class="date">on <time datetime={date.toISOString()}>{News.formatDate(post.date)}</time></small>
		</p>
	</article>

	<script is:inline nomodule src="//play.pokemonshowdown.com/js/lib/ps-polyfill.js"></script>
	<script is:inline src="//play.pokemonshowdown.com/js/lib/preact.min.js"></script>
	<script es3 src="/js/net.ts"></script>
	<script es3 src="/js/news-editor.tsx"></script>
</Layout>
